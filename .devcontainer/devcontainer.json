{
  "name": "TaskFlow Workshop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot-chat",
        "ms-playwright.playwright",
        "qwtel.sqlite-viewer",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "TaskFlow App",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install && npx playwright install chromium --with-deps",
  "remoteUser": "node"
}
